    lines += ["", "### R：RAG业务文档/向量库", ""]
    lines += markdown_table(["ID", "来源", "文件/模块", "内容", "置信度"], _evidence_rows(store.get("R", []), []))
    lines += ["", "### W：Tavily外部实时证据", ""]
    lines += markdown_table(["ID", "来源", "URL", "内容", "置信度"], _evidence_rows(store.get("W", []), []))

    lines += [
        "",
        "## 风险与不确定性",
        "",
    ]
    lines += markdown_table(
        ["风险", "表现", "处理方式"],
        [
            ["实体不一致", "用户问小米却返回宋PLUS/其他品牌车型", "品牌过滤、内容过滤和证据编号三层校验；不一致结果剔除或降级"],
            ["时间不一致", "用户要近半年却查近12个月", "analysis_plan 统一 time_range，所有工具引用同一字段"],
            ["RAG语义噪声", "向量相似但主题弱相关", "按品牌、主题、日期过滤，并展示 rejected_count"],
            ["外部来源质量", "低质量网页、旧网页或股票预测混入", "来源等级A/B/C，C级默认剔除"],
            ["置信区间虚假精确", "没有计算过程却写95% CI", "只给可靠性评分，不伪造CI"],
        ],
    )
    return "\n".join(lines)


def build_quality_summary(plan: Dict[str, Any], store: Dict[str, Any], rag_result: Dict[str, Any], tavily_result: Dict[str, Any]) -> Dict[str, Any]:
    missing = []
    if not store.get("D"):
        missing.append("缺少结构化销量/车型数据")
    if plan.get("target_brand") and not any(plan["target_brand"] in str(item.get("content")) for item in store.get("D", [])):
        missing.append("结构化证据中目标品牌不足")
    if not store.get("R"):
        missing.append("缺少RAG业务文档证据或已被一致性过滤")
    if not store.get("W"):
        missing.append("缺少合格外部实时证据")
    return {
        "missing": missing,
        "rag_rejected_count": rag_result.get("rejected_count", 0),
        "tavily_rejected_count": tavily_result.get("rejected_count", 0),
        "quality_passed": len(missing) == 0,
    }
