def _jsonable(value: Any) -> Any:
    if isinstance(value, Decimal):
        return float(value)
    if isinstance(value, (datetime, date)):
        return value.isoformat()
    if isinstance(value, dict):
        return {str(k): _jsonable(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [_jsonable(v) for v in value]
    return value


def _clean(value: Any, limit: int = 180) -> str:
    if value is None:
        return "-"
    text = str(value).replace("\r", " ").replace("\n", " ")
    text = " ".join(text.split())
    return text[:limit] + ("..." if len(text) > limit else "")


def _month_shift(yyyymm: int, delta: int) -> int:
    year = yyyymm // 100
    month = yyyymm % 100
    total = year * 12 + (month - 1) + delta
    return (total // 12) * 100 + (total % 12 + 1)


def _month_count_from_range(time_range: str) -> int:
    text = time_range or ""
    if any(k in text for k in ["近半年", "最近半年", "6个月", "六个月"]):
        return 6
    if any(k in text for k in ["近三个月", "最近3个月", "3个月", "三个月"]):
        return 3
    if any(k in text for k in ["近12个月", "最近12个月", "一年", "12个月"]):
        return 12
    return 6


def normalize_time_range(question: str, requested: Optional[str]) -> str:
    source = requested or question or ""
    months = _month_count_from_range(source)
    return f"最近{months}个月"


def infer_brand(question: str, fallback: Optional[str] = None) -> Optional[str]:
    if fallback:
        return fallback
    for brand, aliases in BRAND_ALIASES.items():
        if any(alias and alias in question for alias in aliases):
            return brand
    return None


def brand_aliases(brand: Optional[str]) -> List[str]:
    if not brand:
        return []
    return BRAND_ALIASES.get(brand, [brand])


def _infer_price_band(question: str) -> Optional[str]:
    match = re.search(r"(\d{1,3})\s*[-~到至]\s*(\d{1,3})\s*万", question)
    if match:
        return f"{match.group(1)}-{match.group(2)}万"
    for token in ["10万以下", "10-15万", "15-20万", "20-30万", "30-50万", "50万以上"]:
        if token in question:
            return token
    return None


def _infer_power_type(question: str) -> Optional[str]:
    if any(k in question for k in ["纯电", "BEV", "EV"]):
        return "纯电动"
    if any(k in question for k in ["插混", "PHEV"]):
        return "插电式混合动力"
    if "增程" in question:
        return "增程式"
    if "新能源" in question:
        return "新能源"
    return None


def build_analysis_plan(
    question: str,
    brand: Optional[str],
    segment: Optional[str],
    analysis_type: str,
    time_range: Optional[str],
) -> Dict[str, Any]:
    brand = infer_brand(question, brand)
    normalized_time = normalize_time_range(question, time_range)
    price_band = _infer_price_band(question)
    power_type = _infer_power_type(question)
    scope = segment or ("新能源汽车" if "新能源" in question else "乘用车")
    fields = [
        "总体市场规模/TAM",
        "目标细分市场/SAM",
        "目标品牌或车型/SOM",
        "月度趋势与环比",
        "车型贡献",
        "价格带/车型级别",
        "动力类型结构",
        "竞品份额",
        "RAG业务文档证据",
        "Tavily外部实时证据",
    ]
    return {
        "question": question,
        "target_brand": brand,
        "brand_aliases": brand_aliases(brand),
        "market_scope": scope,
        "analysis_type": analysis_type,
        "time_range": normalized_time,
        "month_count": _month_count_from_range(normalized_time),
        "price_band": price_band,
        "power_type": power_type,
        "geography": "中国",
        "assumptions": [
            "默认以中国新能源乘用车市场为核心范围。",
            "若用户未显式给出时间，默认按最近6个月处理，避免旧数据稀释近期判断。",
            "品牌、时间、价格带、动力类型必须贯穿 SQL/RAG/Tavily/框架分析。",
        ],
        "required_data_fields": fields,
        "rag_query": _build_rag_query(question, brand, normalized_time),
        "tavily_query": _build_tavily_query(question, brand, normalized_time),
    }


def _build_rag_query(question: str, brand: Optional[str], time_range: str) -> str:
    topic = " ".join(["销量", "竞品", "价格", "智能化", "渠道", "风险"])
    return " ".join(part for part in [brand, question, time_range, topic] if part)


def _build_tavily_query(question: str, brand: Optional[str], time_range: str) -> str:
    return " ".join(part for part in [brand, question, time_range, "销量 交付 市场份额 竞品 战略"] if part)


def _db_connect():
    import psycopg2
    from psycopg2.extras import RealDictCursor
    from retrieval.vector_store import DB_CONFIG

    return psycopg2.connect(**DB_CONFIG, cursor_factory=RealDictCursor, connect_timeout=5)


def _brand_condition(aliases: List[str]) -> Tuple[str, List[Any]]:
    if not aliases:
        return "1=1", []
    fields = ['"企业名称"', '"产品商标"', '"通用名称"']
    parts: List[str] = []
    params: List[Any] = []
    for alias in aliases:
        for field in fields:
            parts.append(f"{field} ILIKE %s")
            params.append(f"%{alias}%")
    return "(" + " OR ".join(parts) + ")", params


def _new_energy_condition(plan: Dict[str, Any]) -> Tuple[str, List[Any]]:
    if plan.get("power_type") == "新能源" or "新能源" in str(plan.get("market_scope") or ""):
        return '"技术类型" IN (%s,%s,%s)', ["纯电动", "插电式混合动力", "增程式"]
    if plan.get("power_type") and plan["power_type"] != "新能源":
        return '"技术类型" = %s', [plan["power_type"]]
    return "1=1", []


def run_structured_market_queries(plan: Dict[str, Any]) -> Dict[str, Any]:
    """Run targeted SQL evidence queries for the same plan used by RAG/Tavily."""
    try:
        conn = _db_connect()
        cur = conn.cursor()
        cur.execute('SELECT MAX("销售日期") AS max_month FROM sales_import')
        max_month = int(cur.fetchone()["max_month"])
        min_month = _month_shift(max_month, -(int(plan.get("month_count") or 6) - 1))

        common_cond, common_params = _new_energy_condition(plan)
        brand_cond, brand_params = _brand_condition(plan.get("brand_aliases") or [])
        period_cond = '"销售日期" BETWEEN %s AND %s'
        period_params = [min_month, max_month]

        blocks: List[Dict[str, Any]] = []

        def add_block(name: str, sql: str, params: List[Any], purpose: str) -> None:
            cur.execute(sql, params)
            rows = [_jsonable(dict(row)) for row in cur.fetchall()]
            blocks.append({
                "name": name,
                "purpose": purpose,
                "rows": rows,
                "row_count": len(rows),
            })

        where_market = f"{period_cond} AND {common_cond}"
        params_market = period_params + common_params
        add_block(
            "market_overview",
            f'''
            SELECT SUM("销量") AS total_sales,
                   COUNT(DISTINCT "企业名称") AS brand_count,
                   COUNT(DISTINCT "通用名称") AS model_count,
                   MIN("销售日期") AS period_start,
                   MAX("销售日期") AS period_end
            FROM sales_import
            WHERE {where_market}
            ''',
            params_market,
            "TAM/总体市场规模",
        )
        add_block(
            "monthly_trend",
            f'''
            SELECT "销售日期" AS month,
                   SUM("销量") AS sales
            FROM sales_import
            WHERE {where_market}
            GROUP BY "销售日期"
            ORDER BY "销售日期"
            ''',
            params_market,
            "最近周期月度趋势与环比判断",
        )
        add_block(
            "competitor_share",
            f'''
            SELECT "企业名称" AS brand,
                   SUM("销量") AS sales,
                   COUNT(DISTINCT "通用名称") AS model_count,
                   ROUND(SUM("销量") * 100.0 / NULLIF(SUM(SUM("销量")) OVER (), 0), 2) AS share_pct
            FROM sales_import
            WHERE {where_market}
            GROUP BY "企业名称"
            ORDER BY sales DESC
            LIMIT 12
            ''',
            params_market,
            "主要竞品份额/竞争格局",
        )

        if plan.get("target_brand"):
            where_brand = f"{period_cond} AND {common_cond} AND {brand_cond}"
            params_brand = period_params + common_params + brand_params
            add_block(
                "target_brand_performance",
                f'''
                SELECT "企业名称" AS brand,
                       SUM("销量") AS sales,
                       COUNT(DISTINCT "通用名称") AS model_count,
                       MIN("销售日期") AS period_start,
                       MAX("销售日期") AS period_end
                FROM sales_import
                WHERE {where_brand}
                GROUP BY "企业名称"
                ORDER BY sales DESC
                LIMIT 10
                ''',
                params_brand,
                "SOM/目标品牌近期表现",
            )
            add_block(
                "model_contribution",
                f'''
                SELECT "通用名称" AS model,
                       "企业名称" AS brand,
                       "技术类型" AS power_type,
                       "车型级别" AS vehicle_level,
                       "乘用车细分" AS segment,
                       SUM("销量") AS sales
                FROM sales_import
                WHERE {where_brand}
                GROUP BY "通用名称", "企业名称", "技术类型", "车型级别", "乘用车细分"
                ORDER BY sales DESC
                LIMIT 12
                ''',
                params_brand,
                "目标品牌车型贡献，避免错把无关车型当主证据",
            )
            add_block(
                "power_mix",
                f'''
                SELECT "技术类型" AS power_type,
                       SUM("销量") AS sales,
                       COUNT(DISTINCT "通用名称") AS model_count
                FROM sales_import
                WHERE {where_brand}
                GROUP BY "技术类型"
                ORDER BY sales DESC
                ''',
                params_brand,
                "动力类型结构",
            )
            config_where, config_params = _config_brand_condition(plan.get("brand_aliases") or [])
            add_block(
                "price_and_config",
                f'''
                SELECT "车型名称" AS model,
                       "厂商" AS maker,
                       "能源类型" AS energy_type,
                       "级别" AS level,
                       "厂商指导价" AS guide_price,
                       "价格带" AS price_band,
                       "CLTC纯电续航里程" AS cltc_range,
                       "电动机总功率" AS motor_power
                FROM config_data
                WHERE {config_where}
                LIMIT 12
                ''',
                config_params,
                "价格带/配置证据",
            )

        cur.close()
        conn.close()

        for block in blocks:
            if block["name"] == "monthly_trend":
                _add_mom(block["rows"])

        return {
            "success": True,
            "query_mode": "targeted_sql_pack",
            "period_start": min_month,
            "period_end": max_month,
            "blocks": blocks,
            "results": _flatten_structured_results(blocks),
        }
    except Exception as exc:
        return {
            "success": False,
            "error": str(exc),
            "query_mode": "targeted_sql_pack",
            "blocks": [],
            "results": [],
        }


def _config_brand_condition(aliases: List[str]) -> Tuple[str, List[Any]]:
    if not aliases:
        return "1=1", []
    parts: List[str] = []
    params: List[Any] = []
    for alias in aliases:
        for field in ['"厂商"', '"车型名称"', '"款型名称"']:
            parts.append(f"{field} ILIKE %s")
            params.append(f"%{alias}%")
    return "(" + " OR ".join(parts) + ")", params


def _add_mom(rows: List[Dict[str, Any]]) -> None:
    prev = None
    for row in rows:
        sales = row.get("sales") or 0
        if prev:
            row["mom_pct"] = round((sales - prev) * 100.0 / prev, 2) if prev else None
        else:
            row["mom_pct"] = None
        prev = sales


def _flatten_structured_results(blocks: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    results: List[Dict[str, Any]] = []
    for block in blocks:
        for row in block.get("rows", []):
            item = dict(row)
            item["_block"] = block.get("name")
            item["_purpose"] = block.get("purpose")
            results.append(item)
    return results


def _contains_any(text: str, needles: List[str]) -> bool:
    text_lower = (text or "").lower()
    for needle in needles:
        if not needle:
            continue
        # English aliases such as BYD should be matched as words; otherwise
        # they can accidentally hit unrelated substrings in long OCR text.
        if needle.isascii():
            if re.search(rf"(?<![A-Za-z0-9]){re.escape(needle.lower())}(?![A-Za-z0-9])", text_lower):
                return True
        elif needle in text:
            return True
    return False


def _match_aliases(text: str, aliases: List[str]) -> List[str]:
    return [alias for alias in aliases if _contains_any(text, [alias])]


def filter_rag_results(vector_result: Dict[str, Any], plan: Dict[str, Any]) -> Dict[str, Any]:
    rows = vector_result.get("results") or []
    aliases = plan.get("brand_aliases") or []
    themes = sum(THEME_KEYWORDS.values(), [])
    filtered = []
    rejected = []
    for item in rows:
        content = str(item.get("content") or "")
        metadata_probe = " ".join(
            # `brand` can be document-level multi-brand metadata, so it is not
            # strong enough to prove the current chunk supports the target.
            str(item.get(k) or "") for k in ["source", "file_name", "publish_date"]
        )
        strong_brand_probe = metadata_probe + " " + content[:80]
        haystack = " ".join([metadata_probe, content])
        brand_hits = _match_aliases(strong_brand_probe, aliases)
        brand_ok = True if not aliases else bool(brand_hits)
        topic_ok = _contains_any(haystack, themes) or _contains_any(haystack, [plan.get("market_scope", "")])
        if brand_ok and topic_ok:
            accepted = dict(item)
            accepted["evidence_note"] = "accepted_by_brand_topic_filter"
            accepted["brand_hits"] = brand_hits
            filtered.append(accepted)
        else:
            rejected.append({
                "reason": "brand_or_topic_mismatch",
                "brand_hits": brand_hits,
                "topic_ok": topic_ok,
                "item": item,
            })
    result = dict(vector_result)
    result["raw_count"] = len(rows)
    result["results"] = filtered
    result["rejected_count"] = len(rejected)
    result["rejected_samples"] = rejected[:3]
    return result


def _source_quality(url: str, title: str = "") -> str:
    probe = (url or title or "").lower()
    if any(domain in probe for domain in HIGH_QUALITY_DOMAINS):
        return "A"
    if any(domain in probe for domain in LOW_QUALITY_DOMAINS):
        return "C"
    return "B"


def filter_tavily_results(tavily_result: Dict[str, Any], plan: Dict[str, Any]) -> Dict[str, Any]:
    rows = tavily_result.get("results") or []
    aliases = plan.get("brand_aliases") or []
    filtered = []
    rejected = []
    for item in rows:
        title = str(item.get("title") or "")
        url = str(item.get("url") or item.get("link") or "")
        snippet = str(item.get("snippet") or item.get("content") or "")
        haystack = " ".join([title, url, snippet])
        quality = _source_quality(url, title)
        brand_ok = True if not aliases else _contains_any(haystack, aliases)
        low_quality = quality == "C"
        if brand_ok and not low_quality:
            accepted = dict(item)
            accepted["source_quality"] = quality
            accepted["publish_date_detected"] = infer_source_date(title, snippet, url)
            filtered.append(accepted)
        else:
            rejected.append({"reason": "low_quality_or_brand_mismatch", "quality": quality, "item": item})
    result = dict(tavily_result)
    result["raw_count"] = len(rows)
    result["results"] = filtered
    result["rejected_count"] = len(rejected)
    result["rejected_samples"] = rejected[:3]
    return result


def infer_source_date(*parts: Any) -> str:
    text = " ".join(str(part or "") for part in parts)
    match = re.search(r"20\d{2}(?:[-/.年]\d{1,2}(?:[-/.月]\d{1,2}日?)?)?", text)
    if not match:
        return "未识别"
    return match.group(0).replace("年", "-").replace("月", "-").replace("日", "").replace("/", "-").replace(".", "-")


def build_evidence_store(
    structured_result: Dict[str, Any],
    nl2sql_result: Dict[str, Any],
    vector_result: Dict[str, Any],
    tavily_result: Dict[str, Any],
) -> Dict[str, Any]:
    store = {"D": [], "R": [], "W": []}
    for block in structured_result.get("blocks") or []:
        for row in block.get("rows") or []:
            eid = f"D{len(store['D']) + 1}"
            store["D"].append({
                "id": eid,
                "source": "structured_market_db",
                "block": block.get("name"),
                "purpose": block.get("purpose"),
                "content": row,
                "confidence": "高" if structured_result.get("success") else "低",
            })
    for row in nl2sql_result.get("results") or []:
        eid = f"D{len(store['D']) + 1}"
        store["D"].append({
            "id": eid,
            "source": "nl2sql_pg",
            "block": nl2sql_result.get("query_type", "nl2sql"),
            "purpose": "自然语言模板查询补充",
            "content": row,
            "confidence": "中",
        })
    for item in vector_result.get("results") or []:
        eid = f"R{len(store['R']) + 1}"
        store["R"].append({
            "id": eid,
            "source": item.get("source") or "RAG",
            "file_name": item.get("file_name"),
            "publish_date": item.get("publish_date"),
            "content": item.get("content"),
            "score": item.get("score"),
            "confidence": "中",
        })
    for item in tavily_result.get("results") or []:
        eid = f"W{len(store['W']) + 1}"
        store["W"].append({
            "id": eid,
            "title": item.get("title"),
            "url": item.get("url") or item.get("link"),
            "publish_date": item.get("publish_date_detected") or infer_source_date(item.get("title"), item.get("snippet"), item.get("url")),
            "content": item.get("snippet") or item.get("content"),
            "source_quality": item.get("source_quality", "B"),
            "confidence": "中高" if item.get("source_quality") == "A" else "中",
        })
    store["summary"] = {
        "structured": len(store["D"]),
        "rag": len(store["R"]),
        "web": len(store["W"]),
    }
    return store


def evidence_ids(store: Dict[str, Any], prefix: str, limit: int = 4) -> str:
    return ", ".join(item["id"] for item in store.get(prefix, [])[:limit]) or "无"


def _get_block(structured_result: Dict[str, Any], name: str) -> Dict[str, Any]:
    for block in structured_result.get("blocks") or []:
        if block.get("name") == name:
            return block
    return {}


def _sum_rows(rows: List[Dict[str, Any]], key: str) -> float:
    total = 0.0
    for row in rows:
        try:
            total += float(row.get(key) or 0)
        except (TypeError, ValueError):
            continue
    return total


def _fmt_int(value: Any) -> str:
    try:
        return f"{int(round(float(value))):,}"
    except (TypeError, ValueError):
        return "-"


def _fmt_pct(value: Any) -> str:
    try:
        return f"{float(value):.2f}%"
    except (TypeError, ValueError):
        return "-"


def _structured_metrics(plan: Dict[str, Any], structured_result: Dict[str, Any]) -> Dict[str, Any]:
    overview = (_get_block(structured_result, "market_overview").get("rows") or [{}])[0]
    target_rows = _get_block(structured_result, "target_brand_performance").get("rows") or []
    competitor_rows = _get_block(structured_result, "competitor_share").get("rows") or []
    model_rows = _get_block(structured_result, "model_contribution").get("rows") or []
    power_rows = _get_block(structured_result, "power_mix").get("rows") or []
    trend_rows = _get_block(structured_result, "monthly_trend").get("rows") or []
    price_rows = _get_block(structured_result, "price_and_config").get("rows") or []

    target_sales = _sum_rows(target_rows, "sales")
    market_sales = float(overview.get("total_sales") or 0) if overview else 0
    share = round(target_sales * 100.0 / market_sales, 2) if market_sales else None
    top_model = model_rows[0] if model_rows else {}
    top_competitors = competitor_rows[:5]
    latest_month = trend_rows[-1] if trend_rows else {}
    peak_month = max(trend_rows, key=lambda row: row.get("sales") or 0) if trend_rows else {}

    return {
        "brand": plan.get("target_brand") or "目标品牌",
        "market_sales": market_sales,
        "market_brand_count": overview.get("brand_count"),
        "market_model_count": overview.get("model_count"),
        "period_start": overview.get("period_start") or structured_result.get("period_start"),
        "period_end": overview.get("period_end") or structured_result.get("period_end"),
        "target_sales": target_sales,
        "target_share": share,
        "target_rows": target_rows,
        "top_model": top_model,
        "top_competitors": top_competitors,
        "model_rows": model_rows,
        "power_rows": power_rows,
        "trend_rows": trend_rows,
        "latest_month": latest_month,
        "peak_month": peak_month,
        "price_rows": price_rows,
    }


def _structured_query_rows(structured_result: Dict[str, Any], nl2sql_result: Dict[str, Any]) -> List[List[Any]]:
    rows = []
    rows.append([
        "NL2SQL / 语义转结构化查询",
        "把用户自然语言问题转成数据库查询补充",
        len(nl2sql_result.get("results") or []),
        "用于补充临时问题，不作为唯一证据底座",
    ])
    for block in structured_result.get("blocks") or []:
        rows.append([
            block.get("name"),
            block.get("purpose"),
            block.get("row_count"),
            "进入 D 证据库" if block.get("rows") else "无结果，需补查",
        ])
    return rows


