        rows.append([row.get("power_type"), _fmt_int(row.get("sales")), _fmt_pct(share), row.get("model_count")])
    return rows


def _business_evidence_rows(store: Dict[str, Any], metrics: Dict[str, Any]) -> List[List[Any]]:
    rows = []
    for item in store.get("D", [])[:18]:
        block = item.get("block")
        content = item.get("content") or {}
        if block == "market_overview":
            metric = "市场底盘"
            conclusion = f"周期{content.get('period_start')}-{content.get('period_end')}，总体销量{_fmt_int(content.get('total_sales'))}，品牌{content.get('brand_count')}个。"
        elif block == "monthly_trend":
            metric = "月度趋势"
            conclusion = f"{content.get('month')}销量{_fmt_int(content.get('sales'))}，环比{_fmt_pct(content.get('mom_pct')) if content.get('mom_pct') is not None else '首月无环比'}。"
        elif block == "competitor_share":
            metric = "竞品份额"
            conclusion = f"{content.get('brand')}销量{_fmt_int(content.get('sales'))}，份额{_fmt_pct(content.get('share_pct'))}。"
        elif block == "target_brand_performance":
            metric = "目标品牌表现"
            conclusion = f"{content.get('brand')}销量{_fmt_int(content.get('sales'))}，车型{content.get('model_count')}个。"
        elif block == "model_contribution":
            metric = "车型贡献"
            conclusion = f"{content.get('model')}贡献{_fmt_int(content.get('sales'))}，动力={content.get('power_type')}，级别={content.get('vehicle_level')}。"
        elif block == "power_mix":
            metric = "动力结构"
            conclusion = f"{content.get('power_type')}销量{_fmt_int(content.get('sales'))}，车型{content.get('model_count')}个。"
        elif block == "price_and_config":
            metric = "价格/配置"
            conclusion = f"{content.get('model')}指导价{content.get('guide_price')}，能源={content.get('energy_type')}，级别={content.get('level')}。"
        else:
            metric = block or "结构化证据"
            conclusion = "; ".join(f"{k}={_clean(v, 50)}" for k, v in list(content.items())[:4]) if isinstance(content, dict) else _clean(content)
        rows.append([item.get("id"), metric, conclusion, item.get("purpose"), item.get("confidence")])
    return rows


def build_insight_cards(
    plan: Dict[str, Any],
    evidence_store: Dict[str, Any],
    confidence: float,
    structured_result: Optional[Dict[str, Any]] = None,
) -> List[Dict[str, Any]]:
    metrics = _structured_metrics(plan, structured_result or {})
    brand = metrics.get("brand") or "目标品牌"
    top_model = metrics.get("top_model") or {}
    top_competitors = metrics.get("top_competitors") or []
    leader = top_competitors[0] if top_competitors else {}
    target_share = metrics.get("target_share")
    top_model_share = None
    if metrics.get("target_sales") and top_model.get("sales"):
        top_model_share = round(float(top_model.get("sales")) * 100.0 / float(metrics.get("target_sales")), 2)

    cards: List[Dict[str, Any]] = []
    if metrics.get("target_sales"):
        cards.append({
            "title": f"{brand}的现实份额先看销量底盘",
            "insight": (
                f"在{metrics.get('period_start')}-{metrics.get('period_end')}口径下，{brand}销量约"
                f"{_fmt_int(metrics.get('target_sales'))}辆，占本轮市场约{_fmt_pct(target_share)}；"
                f"这说明本轮战略分析应先围绕份额防守、主销车型稳定性和竞品挤压展开。"
            ),
            "evidence": "D1 + 目标品牌表现/竞品份额D证据",
            "action": "先把目标从“泛泛谈策略”收窄到：份额保持、主销车型接续、同价位竞品防守三个问题。",
            "confidence": round(confidence, 2),
        })
    if top_model:
        cards.append({
            "title": f"主销车型决定策略抓手",
            "insight": (
                f"{brand}本轮销量贡献最高的车型是{top_model.get('model')}，销量约{_fmt_int(top_model.get('sales'))}辆，"
                f"约占目标品牌销量{_fmt_pct(top_model_share)}。这类车型应作为价格、配置、渠道和竞品应对的优先观察对象。"
            ),
            "evidence": "车型贡献D证据",
            "action": "围绕Top车型补齐同价位竞品、配置差异、终端优惠和用户口碑，不要只看品牌总量。",
            "confidence": round(confidence, 2),
        })
    if leader:
        cards.append({
            "title": "竞品压力要按同一时间窗口比较",
            "insight": (
                f"本轮竞品矩阵中，头部企业为{leader.get('brand')}，份额约{_fmt_pct(leader.get('share_pct'))}。"
                f"如果目标品牌不是第一名，需要看差距；如果已是第一名，需要看第二梯队增速和价格战压力。"
            ),
            "evidence": "竞品份额D证据",
            "action": "下一版应把竞品矩阵升级为销量份额、车型数、价格带、动力类型、智能化和渠道六列。",
            "confidence": round(confidence, 2),
        })
    if not evidence_store.get("W"):
        cards.append({
            "title": "缺少实时外部证据，战略判断必须降级",
            "insight": "本轮没有合格Tavily外部证据，无法充分覆盖近期价格战、财报、渠道调整、出口或舆情事件。",
            "evidence": "W=0",
            "action": "补查权威外部来源后再给高置信度战略建议；当前只能形成结构化数据驱动的初步判断。",
            "confidence": round(max(0.2, confidence - 0.15), 2),
        })
    return cards[:4]


def markdown_table(headers: List[str], rows: List[List[Any]]) -> List[str]:
    if not rows:
        return ["_本轮没有可展示记录。_"]
    lines = [
        "| " + " | ".join(headers) + " |",
        "| " + " | ".join(["---"] * len(headers)) + " |",
    ]
    for row in rows:
        cells = [_clean(cell, 220).replace("|", "/") for cell in row]
        lines.append("| " + " | ".join(cells) + " |")
    return lines


def _evidence_rows(items: List[Dict[str, Any]], fields: List[str]) -> List[List[Any]]:
    rows = []
    for item in items[:12]:
        content = item.get("content")
        if isinstance(content, dict):
            content_text = "; ".join(f"{k}={_clean(v, 60)}" for k, v in list(content.items())[:8])
        else:
            content_text = _clean(content, 220)
        rows.append([item.get("id"), item.get("source") or item.get("title"), item.get("block") or item.get("file_name") or item.get("url"), content_text, item.get("confidence")])
    return rows


def _structured_block_rows(structured_result: Dict[str, Any], block_name: str, limit: int = 8) -> List[List[Any]]:
    for block in structured_result.get("blocks") or []:
        if block.get("name") == block_name:
            rows = []
            for row in (block.get("rows") or [])[:limit]:
                rows.append([k + "=" + _clean(v, 80) for k, v in list(row.items())[:8]])
            return [[idx + 1, "; ".join(row)] for idx, row in enumerate(rows)]
    return []


